{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{{- range sort (where .Pages "Sitemap.Disable" "ne" true) "RelPermalink" }}
  {{- if and .Permalink (ne .Kind "404") (not .Params.noindex) }}
  {{- $p := 0.7 -}}
  {{- if .IsHome }}{{ $p = 1.0 }}{{ else if .Params.trackHome }}{{ $p = 0.9 }}{{ else if eq .Kind "section" }}{{ $p = 0.8 }}{{ else if .Params.priority }}{{ $p = .Params.priority }}{{ end }}
  {{- with .Params.sitemap }}{{ with .priority }}{{ $p = . }}{{ end }}{{ end }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- if not .Lastmod.IsZero }}
    <lastmod>{{ .Lastmod.Format "2006-01-02" }}</lastmod>
    {{- end }}
    <changefreq>{{ .Sitemap.ChangeFreq | default "weekly" }}</changefreq>
    <priority>{{ $p }}</priority>
    {{- if .IsTranslated }}
    {{- range .AllTranslations }}
    <xhtml:link rel="alternate" hreflang="{{ .Language.Locale }}" href="{{ .Permalink }}"/>
    {{- end }}
    {{- range .AllTranslations }}{{ if eq .Language.Name "en" }}
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ .Permalink }}"/>
    {{- end }}{{ end }}
    {{- end }}
  </url>
  {{- end }}
{{- end }}
</urlset>
